{
  "name": "qcmm",
  "version": "1.0.0",
  "description": "QCMM — Markur Pin Quest, a location-based adventure app for Staunton, VA",
  "type": "module",
  "author": "Brad Thomas",
  "license": "MIT",
  "keywords": [
    "astro",
    "qcmm",
    "location",
    "check-in",
    "staunton"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bradthomasdesign/markur-pin-quest"
  },
  "homepage": "https://qcmm.app",
  "bugs": {
    "url": "https://github.com/bradthomasdesign/markur-pin-quest/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site .vercel/output/static",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm lint && pnpm check && pnpm build",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.0",
    "@astrojs/netlify": "^7.0.2",
    "@astrojs/react": "5.0.0",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/vercel": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.74",
    "@iconify/react": "^6.0.2",
    "@keystatic/astro": "^5.1.0",
    "@keystatic/core": "^0.5.50",
    "@supabase/supabase-js": "^2.112.2",
    "@types/leaflet": "^1.9.22",
    "astro": "6.0.0",
    "astro-icon": "^1.1.5",
    "astro-mastodon": "^0.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.9.3",
    "schema-dts": "^1.1.2",
    "sharp": "^0.34.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.7",
    "@eslint/js": "^9.17.0",
    "@pagefind/default-ui": "^1.3.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^15.14.0",
    "pagefind": "^1.3.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

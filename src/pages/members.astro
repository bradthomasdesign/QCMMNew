---
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import MembersLeaderboard from '@/components/members/MembersLeaderboard';
import AuthAwareCTA from '@/components/auth/AuthAwareCTA';
---
<PageLayout title="Who's on the quest?" description="The top pin collectors. See how many XP fellow adventurers have earned, and how you stack up." bgImage="/staunton.jpg">
  <Hero layout="centered" size="sm" class="isolate" bgImage="/staunton.jpg">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="trophy" size="sm" />
      Members
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Who's on</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">the quest?</span>
    </h1>
    <p slot="description">The top pin collectors. See how many XP fellow adventurers have earned, and how you stack up.</p>
    <Fragment slot="actions">
      <AuthAwareCTA
        signInHref="/auth"
        signInLabel="Sign in to join →"
        client:load
      />
    </Fragment>
  </Hero>

  <section class="relative z-10 py-16 bg-background border-t border-border">
    <div class="mx-auto max-w-2xl px-6">
      <MembersLeaderboard client:load />
    </div>
  </section>
</PageLayout>

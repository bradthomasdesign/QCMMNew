---
import PageLayout from '@/layouts/PageLayout.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import AuthForm from '@/components/auth/AuthForm';
---
<PageLayout
  title="Sign In — QCMM"
  description="Sign in or create a free account to start collecting pins at Queen City Mischief & Magic."
>
  <section class="py-24 flex flex-col items-center justify-center min-h-[60vh] px-6">
    <div class="w-full max-w-sm flex flex-col gap-6">
      <div class="text-center">
        <Badge variant="brand" pill class="mb-4">
          <Icon name="user" size="sm" />
          Account
        </Badge>
        <h1 class="font-display text-3xl font-bold text-foreground mb-2">Welcome back</h1>
        <p class="text-foreground-muted">Sign in to your QCMM account or create a new one to start collecting pins.</p>
      </div>

      <div class="bg-[var(--background)] border border-[var(--border)] rounded-2xl p-6 shadow-[var(--theme-shadow-md)]">
        <AuthForm client:load />
      </div>

      <p class="text-center text-xs text-foreground-muted">
        By creating an account you agree to our
        <a href="/terms" class="text-brand-500 hover:underline">Terms of Service</a>
        and
        <a href="/privacy" class="text-brand-500 hover:underline">Privacy Policy</a>.
      </p>
    </div>
  </section>
</PageLayout>

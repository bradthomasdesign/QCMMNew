---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
---

<LandingLayout
  title="Queen City Mischief & Magic — Staunton's Pin Quest"
  description="Discover downtown Staunton through a location-based adventure. Visit locations, collect pins, earn XP, and connect with fellow explorers at Queen City Mischief & Magic."
  image="/og-default.svg"
  includeOrgSchema={true}
>
  <!-- Hero with video background -->
  <section
    class="hero-dark-gradient relative overflow-hidden isolate min-h-[100dvh] pt-[calc(var(--space-page-top)_+_var(--space-16))] pb-[var(--space-section-xl)]"
    style="background: transparent"
  >
    <!-- Video background — fixed for parallax scroll effect -->
    <video
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
      class="hero-video fixed inset-0 w-full h-full object-cover"
    >
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>

    <!-- Theme-aware overlay -->
    <div class="hero-video-overlay absolute inset-0" aria-hidden="true"></div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator-wrapper absolute bottom-14 left-1/2 -translate-x-1/2 z-10" aria-hidden="true">
      <div class="scroll-indicator flex flex-col items-center gap-0.5">
        <svg class="scroll-indicator-chevron w-7 h-7 text-brand-300/70" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9" />
        </svg>
        <svg class="scroll-indicator-chevron-2 w-7 h-7 text-brand-300/35" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </div>
    </div>

    <!-- Content -->
    <div class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 items-center gap-[var(--space-section-gap)] px-6">
      <div class="flex flex-col text-center items-center animate-hero-stagger">

        <!-- Badge -->
        <div class="mb-[var(--space-heading-gap)]">
          <Badge variant="brand" pill pulse class="dark:text-brand-200">Queen City Mischief &amp; Magic</Badge>
        </div>

        <!-- Title -->
        <div class="hero-title-slot hero-lcp-title mb-[var(--space-heading-gap)]">
          <h1 class="font-display font-black tracking-[-0.045em] leading-[1.05] text-balance text-foreground !text-[clamp(2.4rem,10vw,5.5rem)]">
            Make the most of QCMM.
          </h1>
        </div>

        <!-- Description -->
        <div class="mb-[var(--space-stack-lg)] max-w-xl mx-auto">
          <p class="text-lg leading-relaxed font-medium" style="color: rgba(255,255,255,0.90)">
            Explore downtown Staunton, collect pins at iconic locations, earn XP, and connect with the community at Virginia's most magical free festival.
          </p>
        </div>

        <!-- Actions -->
        <div class="flex w-full flex-col gap-4 sm:w-auto sm:flex-row justify-center">
          <Button size="lg" href="/auth">
            Start your adventure
            <Icon name="arrow-right" size="sm" />
          </Button>
          <Button size="lg" variant="outline" href="/locations">
            <Icon name="map-pin" size="sm" />
            View locations
          </Button>
        </div>

      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="relative z-10 py-10 bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-3 gap-4 text-center">
        <div data-reveal>
          <p class="font-display text-3xl md:text-4xl font-black text-brand-500" data-countup="20000" data-suffix="k+">0k+</p>
          <p class="text-sm text-foreground-muted mt-1">Annual visitors</p>
        </div>
        <div data-reveal data-reveal-delay="1">
          <p class="font-display text-3xl md:text-4xl font-black text-brand-500">100%</p>
          <p class="text-sm text-foreground-muted mt-1">Volunteer-run</p>
        </div>
        <div data-reveal data-reveal-delay="2">
          <p class="font-display text-3xl md:text-4xl font-black text-brand-500">Free</p>
          <p class="text-sm text-foreground-muted mt-1">Always free admission</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <Badge variant="brand" pill>How It Works</Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          Three simple steps
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl">
          No app download required. Just your phone camera and a sense of adventure.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-3">
        <Card hover class="group flex flex-col" data-reveal>
          <div class="flex items-start gap-4 sm:flex-col sm:gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 font-bold shrink-0">
              1
            </div>
            <div class="flex-1">
              <h3 class="text-base font-semibold text-foreground">Create a free account</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Sign up at qcmm.app — all you need is an email address. Already have one? Just sign in.
              </p>
            </div>
          </div>
        </Card>

        <Card hover class="group flex flex-col" data-reveal data-reveal-delay="1">
          <div class="flex items-start gap-4 sm:flex-col sm:gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 font-bold shrink-0">
              2
            </div>
            <div class="flex-1">
              <h3 class="text-base font-semibold text-foreground">Find locations across downtown</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Festival spots are spread across downtown Staunton. Explore the area, keep your eyes open.
              </p>
            </div>
          </div>
        </Card>

        <Card hover class="group flex flex-col" data-reveal data-reveal-delay="2">
          <div class="flex items-start gap-4 sm:flex-col sm:gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 font-bold shrink-0">
              3
            </div>
            <div class="flex-1">
              <h3 class="text-base font-semibold text-foreground">Check in, earn your pin</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Open the location page and tap Check In. Your pin is recorded instantly.
              </p>
            </div>
          </div>
        </Card>
      </div>

      <div class="text-center">
        <Button variant="outline" href="/how-it-works">
          Full guide
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <Badge variant="brand" pill>What's Inside</Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          More than just a map
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl">
          QCMM is a full adventure platform — explore, connect, and discover the stories behind Staunton.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <Card hover href="/locations" class="group flex flex-col" data-reveal>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="map-pin" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Locations</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                An interactive map and full list of every festival spot. Plan your route before the festival, or discover as you go.
              </p>
              <span class="inline-flex items-center gap-1 text-sm font-medium text-brand-500 mt-3 group-hover:gap-2 transition-all">
                Explore the map
                <Icon name="arrow-right" size="sm" />
              </span>
            </div>
          </div>
        </Card>

        <Card hover href="/community" class="group flex flex-col" data-reveal data-reveal-delay="1">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="message-square" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Community</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                A message board for festival attendees. Ask questions, share what you found, or say hello to fellow explorers.
              </p>
              <span class="inline-flex items-center gap-1 text-sm font-medium text-brand-500 mt-3 group-hover:gap-2 transition-all">
                Join the conversation
                <Icon name="arrow-right" size="sm" />
              </span>
            </div>
          </div>
        </Card>

        <Card hover href="/blog" class="group flex flex-col" data-reveal data-reveal-delay="2">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="book-open" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">QCMM News</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Festival news, event updates, and community stories from the team and attendees of Queen City Mischief & Magic.
              </p>
              <span class="inline-flex items-center gap-1 text-sm font-medium text-brand-500 mt-3 group-hover:gap-2 transition-all">
                Read the news
                <Icon name="arrow-right" size="sm" />
              </span>
            </div>
          </div>
        </Card>

        <Card hover href="/members" class="group flex flex-col" data-reveal data-reveal-delay="3">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="trophy" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Members</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                A leaderboard of who has collected the most pins and earned the most XP. See how you stack up against other adventurers.
              </p>
              <span class="inline-flex items-center gap-1 text-sm font-medium text-brand-500 mt-3 group-hover:gap-2 transition-all">
                See the leaderboard
                <Icon name="arrow-right" size="sm" />
              </span>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- About QCMM -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12">
        <div class="flex flex-col justify-center sm:items-center sm:text-center glitch:items-start glitch:text-left" data-reveal="right" data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 mb-6 sm:items-center glitch:items-start">
            <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">About QCMM</Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              A festival built on<br />
              <span class="text-brand-500">magic &amp; community.</span>
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed text-pretty mb-4 sm:max-w-xl glitch:max-w-none">
            Queen City Mischief &amp; Magic is a free, volunteer-run festival celebrating magic across all forms and fandoms — held every fall in the heart of historic downtown Staunton, Virginia.
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed text-pretty mb-8 sm:max-w-xl glitch:max-w-none sm:hidden glitch:block">
            QCMM turns the whole city into the venue. Every alley, storefront, and plaza becomes part of the adventure.
          </p>
          <Button variant="outline" href="/about" class="self-start sm:self-center glitch:self-start sm:hidden glitch:inline-flex">
            About the festival
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>

        <Card variant="elevated" padding="lg" class="h-full flex flex-col" data-reveal="left" data-reveal-delay="1" data-reveal-ease="smooth">
          <p class="text-sm text-foreground mb-5 text-center sm:hidden glitch:block">A few things about the festival.</p>
          <div class="grid grid-cols-2 sm:grid-cols-4 glitch:grid-cols-2 gap-3 flex-1 auto-rows-fr">
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="users" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">20k+ Visitors</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="heart" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">100% Volunteer</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="ticket" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Always Free</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="map-pin" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Staunton, VA</p>
            </div>
          </div>
        </Card>

        <div class="hidden sm:flex justify-center glitch:hidden" data-reveal data-reveal-delay="2">
          <Button variant="outline" href="/about">
            About the festival
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="glitch:hidden mx-auto max-w-2xl px-6 text-center" data-reveal>
      <Badge variant="brand" pill class="mb-6">Ready to play?</Badge>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Your adventure starts now.
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        Create a free account and start collecting pins at Queen City Mischief &amp; Magic.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href="/auth" class="cta-btn-brand">
          Create free account
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/how-it-works">
          How it works
        </Button>
      </div>
    </div>

    <LetterGlitchBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Your adventure starts now.
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        Create a free account and start collecting pins at Queen City Mischief &amp; Magic.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href="/auth" class="hero-btn-brand">
          Create free account
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/how-it-works">
          How it works
        </Button>
      </div>
    </LetterGlitchBand>
  </section>

</LandingLayout>

<style>
  /* Video sits behind everything in the hero stacking context */
  .hero-video {
    z-index: -2;
  }

  /* Purple-to-dark overlay — semi-transparent so video shows through */
  .hero-video-overlay {
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--color-brand-600) 48%, transparent) 0%,
      rgba(0, 0, 0, 0.62) 100%
    );
  }

  /* Light mode gets same dark treatment (hero-dark-gradient remaps vars) */
  html:not(.dark) .hero-video-overlay {
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--color-brand-700) 54%, transparent) 0%,
      rgba(0, 0, 0, 0.68) 100%
    );
  }

  /* Scroll indicator — desktop only */
  .scroll-indicator-wrapper {
    display: none;
  }
  @media (min-width: 1024px) and (min-height: 500px) {
    .scroll-indicator-wrapper { display: block; }
  }

  .scroll-indicator {
    animation: si-fade-in 0.6s ease-out 1.4s backwards;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .scroll-indicator.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
  }
  @keyframes si-fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .scroll-indicator-chevron   { animation: si-bounce 2s ease-in-out 2s infinite; }
  .scroll-indicator-chevron-2 { animation: si-bounce 2s ease-in-out 2.15s infinite; }
  @keyframes si-bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(5px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator,
    .scroll-indicator-chevron,
    .scroll-indicator-chevron-2 { animation: none; opacity: 1; }
  }
</style>

<script>
  function initCountup() {
    const counters = document.querySelectorAll<HTMLElement>('[data-countup]:not([data-countup-init])');
    if (counters.length === 0) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countup ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1200;
        const start = performance.now();
        const tick = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round((eased * target) / 1000) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    counters.forEach((el) => {
      el.dataset.countupInit = 'true';
      observer.observe(el);
    });
  }

  initCountup();

  // Scroll indicator: hide on scroll
  (function () {
    const indicator = document.querySelector<HTMLElement>('.scroll-indicator');
    if (!indicator) return;
    function onScroll() {
      if (window.scrollY > 50) {
        indicator?.classList.add('is-hidden');
        window.removeEventListener('scroll', onScroll);
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>

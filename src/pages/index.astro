---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
---

<LandingLayout
  title="Queen City Mischief & Magic — Staunton's Pin Quest"
  description="Discover downtown Staunton through a location-based adventure. Visit locations, collect pins, earn XP, and connect with fellow explorers at Queen City Mischief & Magic."
  image="/og-default.svg"
  includeOrgSchema={true}
>
  <!-- Hero with video background -->
  <section
    class="hero-dark-gradient relative overflow-hidden isolate min-h-[100dvh] pt-[calc(var(--space-page-top)_+_var(--space-16))] pb-[var(--space-section-xl)]"
    style="background: transparent"
  >
    <!-- Video background — fixed for parallax scroll effect -->
    <video
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
      class="hero-video fixed inset-0 w-full h-full object-cover"
    >
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>

    <!-- Theme-aware overlay -->
    <div class="hero-video-overlay absolute inset-0" aria-hidden="true"></div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator-wrapper absolute bottom-14 left-1/2 -translate-x-1/2 z-10" aria-hidden="true">
      <div class="scroll-indicator flex flex-col items-center gap-0.5">
        <svg class="scroll-indicator-chevron w-7 h-7 text-brand-300/70" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9" />
        </svg>
        <svg class="scroll-indicator-chevron-2 w-7 h-7 text-brand-300/35" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </div>
    </div>

    <!-- Content -->
    <div class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 items-center gap-[var(--space-section-gap)] px-6">
      <div class="flex flex-col text-center items-center animate-hero-stagger">

        <!-- Badge -->
        <div class="mb-[var(--space-heading-gap)]">
          <Badge variant="brand" pill pulse class="dark:text-brand-200">Queen City Mischief &amp; Magic</Badge>
        </div>

        <!-- Title -->
        <div class="hero-title-slot hero-lcp-title mb-[var(--space-heading-gap)]">
          <h1 class="font-display font-black tracking-[-0.045em] leading-[1.05] text-balance text-foreground !text-[clamp(2.4rem,10vw,5.5rem)]">
            Make the most of QCMM.
          </h1>
        </div>

        <!-- Description -->
        <div class="mb-[var(--space-stack-lg)] max-w-xl mx-auto">
          <p class="text-lg leading-relaxed font-medium" style="color: rgba(255,255,255,0.90)">
            Explore downtown Staunton and connect with the community at Virginia's most magical free festival.
          </p>
        </div>

        <!-- Actions -->
        <div class="flex w-full flex-col gap-4 sm:w-auto sm:flex-row justify-center">
          <Button size="lg" variant="outline" href="/locations">
            <Icon name="map-pin" size="sm" />
            View Locations
          </Button>
          <Button size="lg" variant="outline" href="/collections">
            <Icon name="layers" size="sm" />
            Browse Collections
          </Button>
          <Button size="lg" variant="outline" href="/characters">
            <Icon name="users" size="sm" />
            Character List
          </Button>
        </div>

      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="relative z-10 py-10 bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-3 gap-4 text-center">
        <div data-reveal>
          <p class="font-display text-3xl md:text-4xl font-black text-brand-500" data-countup="20000" data-suffix="k+">0k+</p>
          <p class="text-sm text-foreground-muted mt-1">Annual visitors</p>
        </div>
        <div data-reveal data-reveal-delay="1">
          <p class="font-display text-3xl md:text-4xl font-black text-brand-500">100%</p>
          <p class="text-sm text-foreground-muted mt-1">Volunteer-run</p>
        </div>
        <div data-reveal data-reveal-delay="2">
          <p class="font-display text-3xl md:text-4xl font-black text-brand-500">Free</p>
          <p class="text-sm text-foreground-muted mt-1">Always free admission</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SUPPRESSED for festival: "Three simple steps" and "More than just a map" sections -->
  <!-- Re-enable by restoring the sections from the post-festival-edits branch history -->

  <!-- About QCMM -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12">
        <div class="flex flex-col justify-center sm:items-center sm:text-center glitch:items-start glitch:text-left" data-reveal="right" data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 mb-6 sm:items-center glitch:items-start">
            <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">About QCMM</Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              A festival built on<br />
              <span class="text-brand-500">magic &amp; community.</span>
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed text-pretty mb-4 sm:max-w-xl glitch:max-w-none">
            Queen City Mischief &amp; Magic is a free, volunteer-run festival celebrating magic across all forms and fandoms — held every fall in the heart of historic downtown Staunton, Virginia.
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed text-pretty mb-8 sm:max-w-xl glitch:max-w-none sm:hidden glitch:block">
            QCMM turns the whole city into the venue. Every alley, storefront, and plaza becomes part of the adventure.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 self-start sm:self-center glitch:self-start sm:hidden glitch:inline-flex">
            <Button variant="brand" href="https://queencitymagic.com/" class="self-start">
              Official Festival Website
              <Icon name="arrow-right" size="sm" />
            </Button>
            <Button variant="outline" href="#" class="self-start">
              View the Schedule
              <Icon name="calendar" size="sm" />
            </Button>
          </div>
        </div>

        <Card variant="elevated" padding="lg" class="h-full flex flex-col" data-reveal="left" data-reveal-delay="1" data-reveal-ease="smooth">
          <p class="text-sm text-foreground mb-5 text-center sm:hidden glitch:block">A few things about the festival.</p>
          <div class="grid grid-cols-2 sm:grid-cols-4 glitch:grid-cols-2 gap-3 flex-1 auto-rows-fr">
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md cursor-default h-full">
              <Icon name="users" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">20k+ Visitors</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md cursor-default h-full">
              <Icon name="heart" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">100% Volunteer</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md cursor-default h-full">
              <Icon name="ticket" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Always Free</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md cursor-default h-full">
              <Icon name="map-pin" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Staunton, VA</p>
            </div>
          </div>
        </Card>

        <div class="hidden sm:flex justify-center gap-3 glitch:hidden" data-reveal data-reveal-delay="2">
          <Button variant="brand" href="https://queencitymagic.com/">
            Official Festival Website
            <Icon name="arrow-right" size="sm" />
          </Button>
          <Button variant="outline" href="#">
            View the Schedule
            <Icon name="calendar" size="sm" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- SUPPRESSED for festival: "Your adventure starts now" CTA section -->
  <!-- Re-enable by restoring from the post-festival-edits branch history -->

</LandingLayout>

<style>
  /* Video sits behind everything in the hero stacking context */
  .hero-video {
    z-index: -2;
  }

  /* Neutral dark overlay — dims the video without adding a colour cast */
  .hero-video-overlay {
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.38) 0%,
      rgba(0, 0, 0, 0.60) 100%
    );
  }

  /* Scroll indicator — desktop only */
  .scroll-indicator-wrapper {
    display: none;
  }
  @media (min-width: 1024px) and (min-height: 500px) {
    .scroll-indicator-wrapper { display: block; }
  }

  .scroll-indicator {
    animation: si-fade-in 0.6s ease-out 1.4s backwards;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .scroll-indicator.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
  }
  @keyframes si-fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .scroll-indicator-chevron   { animation: si-bounce 2s ease-in-out 2s infinite; }
  .scroll-indicator-chevron-2 { animation: si-bounce 2s ease-in-out 2.15s infinite; }
  @keyframes si-bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(5px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator,
    .scroll-indicator-chevron,
    .scroll-indicator-chevron-2 { animation: none; opacity: 1; }
  }
</style>

<script>
  function initCountup() {
    const counters = document.querySelectorAll<HTMLElement>('[data-countup]:not([data-countup-init])');
    if (counters.length === 0) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countup ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1200;
        const start = performance.now();
        const tick = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round((eased * target) / 1000) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    counters.forEach((el) => {
      el.dataset.countupInit = 'true';
      observer.observe(el);
    });
  }

  initCountup();

  // Scroll indicator: hide on scroll
  (function () {
    const indicator = document.querySelector<HTMLElement>('.scroll-indicator');
    if (!indicator) return;
    function onScroll() {
      if (window.scrollY > 50) {
        indicator?.classList.add('is-hidden');
        window.removeEventListener('scroll', onScroll);
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>

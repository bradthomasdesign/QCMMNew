---
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
---
<PageLayout title="Terms of Service — QCMM" description="Terms and conditions for using QCMM.app.">
  <Hero layout="centered" size="sm" class="isolate">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="file-text" size="sm" />
      Terms
    </Badge>
    <h1 slot="title">Terms of Service</h1>
    <p slot="description">Last updated August 2026</p>
  </Hero>

  <section class="py-16 bg-background border-t border-border">
    <div class="mx-auto max-w-3xl px-6 prose prose-sm prose-neutral dark:prose-invert max-w-none">
      <h2>About QCMM.app</h2>
      <p>QCMM.app is an independently operated companion app for the Queen City Mischief &amp; Magic festival. It is affiliated with the festival but maintained and operated separately. Use of this app is free and does not require an account.</p>

      <h2>Use of the app</h2>
      <p>You may use QCMM.app to explore locations, browse collections, and learn about festival characters. You agree not to attempt to abuse, exploit, or disrupt any part of the app or its underlying services.</p>

      <h2>Location check-ins</h2>
      <p>Check-in features are powered entirely by your browser's local storage. No check-in data is transmitted to or stored on our servers. Check-in markers at festival locations are the property of QCMM — please do not move, damage, or reproduce them.</p>

      <h2>Intellectual property</h2>
      <p>Content on QCMM.app — including character descriptions, location information, and collection artwork — is the property of QCMM.app or its respective rights holders. Do not reproduce or redistribute it without permission.</p>

      <h2>Liability</h2>
      <p>QCMM.app is provided as-is. We are not responsible for inaccuracies in location or event information, loss of locally stored data, or any events beyond our control. For official festival information, visit <a href="https://queencitymagic.com/" target="_blank" rel="noopener noreferrer">queencitymagic.com</a>.</p>

      <h2>Changes</h2>
      <p>We may update these terms from time to time. Continued use of the app after changes constitutes acceptance of the updated terms.</p>

      <h2>Contact</h2>
      <p>Questions? Email <a href="mailto:hello@qcmm.app">hello@qcmm.app</a>.</p>
    </div>
  </section>
</PageLayout>

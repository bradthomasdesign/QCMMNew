---
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
---
<PageLayout
  title="Queen City Mischief & Magic"
  description="A free, volunteer-run festival celebrating magic across all forms and fandoms held every fall in the heart of historic downtown Staunton, Virginia."
  bgImage="/staunton.jpg"
>
  <Hero layout="centered" size="sm" class="isolate" bgImage="/staunton.jpg">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="sparkles" size="sm" />
      About QCMM
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Queen City</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">Mischief &amp; Magic</span>
    </h1>
    <p slot="description">
      A free, volunteer-run festival celebrating magic across all forms and fandoms, held every fall in the heart of historic downtown Staunton, Virginia.
    </p>
    <Fragment slot="actions">
      <Button href="https://queencitymagic.com" variant="outline">
        Visit the official site
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>
  </Hero>

  <!-- Stats -->
  <section class="relative z-10 py-16 bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-3 gap-6 text-center">
        <div data-reveal>
          <p class="font-display text-4xl font-black text-brand-500">20k+</p>
          <p class="text-sm text-foreground-muted mt-1">Annual visitors</p>
        </div>
        <div data-reveal data-reveal-delay="1">
          <p class="font-display text-4xl font-black text-brand-500">100%</p>
          <p class="text-sm text-foreground-muted mt-1">Volunteer-run</p>
        </div>
        <div data-reveal data-reveal-delay="2">
          <p class="font-display text-4xl font-black text-brand-500">Free</p>
          <p class="text-sm text-foreground-muted mt-1">Always free admission</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About the platform -->
  <section class="relative z-10 py-16 bg-background border-t border-border">
    <div class="mx-auto max-w-4xl px-6 flex flex-col gap-12">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex justify-center"><Badge variant="brand" pill>About QCMM.app</Badge></div>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          A companion site built for exploration
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl">
          Queen City Mischief & Magic turns downtown Staunton into the venue. QCMM.app turns every alley, storefront, and plaza into part of the adventure.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-3">
        <Card hover class="flex flex-col text-center items-center" data-reveal>
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 mb-4">
            <Icon name="map-pin" size="md" />
          </div>
          <h3 class="text-base font-semibold text-foreground">Location Check-Ins</h3>
          <p class="text-sm text-foreground-muted leading-relaxed mt-2">
            Visit any festival spot and tap Check In. No app required. Your pin is recorded instantly and XP is added to your profile.
          </p>
        </Card>

        <Card hover class="flex flex-col text-center items-center" data-reveal data-reveal-delay="1">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 mb-4">
            <Icon name="trophy" size="md" />
          </div>
          <h3 class="text-base font-semibold text-foreground">Collect &amp; Earn</h3>
          <p class="text-sm text-foreground-muted leading-relaxed mt-2">
            Every location adds a verified pin to your collection and earns XP. Climb the leaderboard and unlock rewards as you explore.
          </p>
        </Card>

        <Card hover class="flex flex-col text-center items-center" data-reveal data-reveal-delay="2">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 mb-4">
            <Icon name="users" size="md" />
          </div>
          <h3 class="text-base font-semibold text-foreground">Community Driven</h3>
          <p class="text-sm text-foreground-muted leading-relaxed mt-2">
            Share stories, post to the community board, and connect with fellow explorers discovering the same places you are.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- About the festival -->
  <section class="relative z-10 py-16 bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-4xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex justify-center"><Badge variant="brand" pill>The Festival</Badge></div>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          Magic lives in Staunton
        </h2>
      </div>

      <Card variant="elevated" padding="lg" data-reveal>
        <div class="prose prose-invert max-w-none text-foreground-muted leading-relaxed space-y-4">
          <p>
            Queen City Mischief &amp; Magic is Staunton's annual celebration of magic, mystery, and imagination. Named for Queen City, one of Staunton's many historical nicknames, the festival transforms downtown into a living playground for fans of all things magical, from wizarding worlds to stage magic to folklore and beyond.
          </p>
          <p>
            The festival is free to attend, free to explore, and entirely volunteer-run. It has grown year over year to welcome more than 20,000 visitors, all drawn to the charm of a historic Virginia city that feels like it was made for magic.
          </p>
          <p>
            QCMM.app is the official pin quest platform for the festival, a digital adventure layer built on top of the real-world event. Collect pins at festival locations, connect with fellow attendees, and discover the hidden histories of the places you visit.
          </p>
        </div>
      </Card>
    </div>
  </section>

  <!-- CTA -->
  <LetterGlitchBand>
    <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
      Ready to start your quest?
    </h2>
    <p class="text-lg text-foreground-muted mb-8 text-balance">
      Create a free account and join the adventure.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <Button size="lg" href="/auth" class="hero-btn-brand">
        Create free account
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href="/how-it-works">
        How it works
      </Button>
    </div>
  </LetterGlitchBand>
</PageLayout>

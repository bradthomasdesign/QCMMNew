---
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
---
<PageLayout
  title="About — QCMM.app"
  description="A free, volunteer-run festival celebrating magic across all forms and fandoms held every fall in the heart of historic downtown Staunton, Virginia."
  bgImage="/staunton.jpg"
>
  <Hero layout="centered" size="sm" class="isolate" bgImage="/staunton.jpg">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="sparkles" size="sm" />
      About QCMM
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Queen City</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">Mischief &amp; Magic</span>
    </h1>
    <p slot="description">
      A free, volunteer-run festival celebrating magic across all forms and fandoms, held every fall in the heart of historic downtown Staunton, Virginia.
    </p>
    <Fragment slot="actions">
      <Button href="https://queencitymagic.com" variant="outline">
        Visit the official site
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>
  </Hero>

  <!-- Stats -->
  <section class="relative z-10 py-16 bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-3 gap-6 text-center">
        <div data-reveal>
          <p class="font-display text-4xl font-black text-brand-500">20k+</p>
          <p class="text-sm text-foreground-muted mt-1">Annual visitors</p>
        </div>
        <div data-reveal data-reveal-delay="1">
          <p class="font-display text-4xl font-black text-brand-500">100%</p>
          <p class="text-sm text-foreground-muted mt-1">Volunteer-run</p>
        </div>
        <div data-reveal data-reveal-delay="2">
          <p class="font-display text-4xl font-black text-brand-500">Free</p>
          <p class="text-sm text-foreground-muted mt-1">Always free admission</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About the app -->
  <section class="relative z-10 py-16 bg-background border-t border-border">
    <div class="mx-auto max-w-4xl px-6 flex flex-col gap-12">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex justify-center"><Badge variant="brand" pill>About QCMM.app</Badge></div>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          A companion site built for exploration
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl">
          Queen City Mischief &amp; Magic turns downtown Staunton into the venue. QCMM.app helps you find every corner of it.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-3">
        <Card hover class="flex flex-col text-center items-center" data-reveal>
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 mb-4">
            <Icon name="map-pin" size="md" />
          </div>
          <h3 class="text-base font-semibold text-foreground">Explore Locations</h3>
          <p class="text-sm text-foreground-muted leading-relaxed mt-2">
            Browse every festival location on an interactive map and check in as you explore downtown Staunton during the event.
          </p>
        </Card>

        <Card hover class="flex flex-col text-center items-center" data-reveal data-reveal-delay="1">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 mb-4">
            <Icon name="layers" size="md" />
          </div>
          <h3 class="text-base font-semibold text-foreground">Browse Collections</h3>
          <p class="text-sm text-foreground-muted leading-relaxed mt-2">
            Locations are grouped into themed collections, from the wizarding world to Oz and beyond. Discover what each part of the festival has in store.
          </p>
        </Card>

        <Card hover class="flex flex-col text-center items-center" data-reveal data-reveal-delay="2">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 mb-4">
            <Icon name="users" size="md" />
          </div>
          <h3 class="text-base font-semibold text-foreground">Meet the Characters</h3>
          <p class="text-sm text-foreground-muted leading-relaxed mt-2">
            Get to know the characters appearing at the festival. Learn who they are, where they come from and where you might find them during the event.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- About the festival -->
  <section class="relative z-10 py-16 bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-4xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex justify-center"><Badge variant="brand" pill>The Festival</Badge></div>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          Magic lives in Staunton
        </h2>
      </div>

      <Card variant="elevated" padding="lg" data-reveal>
        <div class="prose prose-invert max-w-none text-foreground-muted leading-relaxed space-y-4">
          <p>
            Queen City Mischief &amp; Magic is Staunton's annual celebration of magic, mystery and imagination. Named for Queen City, one of Staunton's many historical nicknames, the festival transforms downtown into a gathering place for fans of all things magical, from wizarding worlds to stage magic to folklore and beyond.
          </p>
          <p>
            The festival is free to attend and entirely volunteer-run. It has grown to welcome more than 20,000 visitors each year to one of Virginia's most distinctive historic downtowns.
          </p>
          <p>
            QCMM.app is an independently operated companion app affiliated with the festival. It serves as a digital guide to help visitors make the most of the event.
          </p>
          <p>
            For year-round news and stories about Staunton, visit <a href="https://stauntonian.com" target="_blank" rel="noopener noreferrer">Stauntonian.com</a>.
          </p>
        </div>
      </Card>
    </div>
  </section>

  <!-- About the Stauntonian -->
  <section class="relative z-10 py-16 bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-4xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex justify-center"><Badge variant="brand" pill>From the Makers of QCMM.app</Badge></div>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          The Stauntonian
        </h2>
      </div>

      <Card variant="elevated" padding="lg" data-reveal>
        <div class="prose prose-invert max-w-none text-foreground-muted leading-relaxed space-y-4">
          <p>
            The Stauntonian is a subscriber-supported publication covering the civic news, events and culture of Staunton, Virginia and surrounding Augusta County. It focuses on the people and stories that shape daily life in the Queen City, without advertising or algorithm-driven content.
          </p>
          <p>
            Free subscribers receive a weekly newsletter with unlimited reading access. Paid subscribers get archive access, story commenting and additional features as they roll out.
          </p>
          <p>
            <a href="https://stauntonian.com" target="_blank" rel="noopener noreferrer">Visit Stauntonian.com</a> to subscribe or learn more.
          </p>
        </div>
        <a
          href="https://www.stauntonian.com/qcmmspecial"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 flex items-center gap-3 rounded-xl border border-brand-500/30 bg-brand-500/10 px-5 py-3.5 hover:bg-brand-500/20 hover:border-brand-500/50 transition-colors group"
        >
          <div class="flex-1">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-500 mb-0.5">Festival Special — Through Sept 30</p>
            <p class="text-sm font-medium text-foreground">Get 25% off a new annual Stauntonian.com subscription — festival special through Sept 30.</p>
          </div>
          <Icon name="arrow-right" size="sm" class="text-brand-500 shrink-0 group-hover:translate-x-0.5 transition-transform" />
        </a>
      </Card>
    </div>
  </section>

</PageLayout>

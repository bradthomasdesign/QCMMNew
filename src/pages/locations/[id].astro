---
import { getCollection } from 'astro:content';
import { createClient } from '@supabase/supabase-js';
import PageLayout from '@/layouts/PageLayout.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import LocationDiscussion from '@/components/locations/LocationDiscussion';
import MiniMap from '@/components/locations/MiniMap';
import CheckInButton from '@/components/locations/CheckInButton';
import LocationStats from '@/components/locations/LocationStats';
import CollectionProgressTag from '@/components/gamification/CollectionProgressTag';

export async function getStaticPaths() {
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );

  const [{ data: locations }, allCollections, allCharacters] = await Promise.all([
    supabase
      .from('locations')
      .select('id, name, description, latitude, longitude, is_secret, difficulty_level, featured_image_url, reward_description, state, country, collection_slugs, character_slugs')
      .eq('is_active', true)
      .order('name'),
    getCollection('locationCollections', (c) => c.data.active),
    getCollection('characters', (c) => c.data.active),
  ]);

  const collectionMap = new Map(allCollections.map((c) => [c.id, c.data]));
  const characterMap = new Map(allCharacters.map((c) => [c.id, c.data]));

  return (locations ?? []).map((loc) => {
    const collections = (loc.collection_slugs ?? [])
      .map((slug: string) => ({ slug, ...collectionMap.get(slug) }))
      .filter((c: any) => c.name);

    const characters = (loc.character_slugs ?? [])
      .map((slug: string) => ({ slug, ...characterMap.get(slug) }))
      .filter((c: any) => c.name);

    return {
      params: { id: loc.id },
      props: { location: loc, collections, characters },
    };
  });
}

const { location, collections, characters } = Astro.props;

function difficultyLabel(level: number | null) {
  if (!level) return null;
  return ['', 'Easy', 'Moderate', 'Hard', 'Expert', 'Legendary'][level] ?? `Level ${level}`;
}

function difficultyColor(level: number | null) {
  if (!level) return '';
  const colors: Record<number, string> = {
    1: 'text-green-600 bg-green-500/10',
    2: 'text-yellow-600 bg-yellow-500/10',
    3: 'text-orange-600 bg-orange-500/10',
    4: 'text-red-600 bg-red-500/10',
    5: 'text-purple-600 bg-purple-500/10',
  };
  return colors[level] ?? 'text-foreground-muted bg-background-secondary';
}

const mapsUrl = `https://www.openstreetmap.org/?mlat=${location.latitude}&mlon=${location.longitude}&zoom=17`;
const difficulty = difficultyLabel(location.difficulty_level);
const locationLine = [location.state, location.country].filter(Boolean).join(', ');
---

<PageLayout
  title={`${location.name} — QCMM`}
  description={location.description ?? `A QCMM pin location in downtown Staunton, VA — ${location.name}.`}
>
  <!-- Back nav -->
  <div class="border-b border-border bg-background-secondary">
    <div class="mx-auto max-w-4xl px-6 py-3">
      <a href="/locations" class="inline-flex items-center gap-1.5 text-sm text-foreground-muted hover:text-foreground transition-colors">
        <Icon name="arrow-left" size="sm" />
        All Locations
      </a>
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-background py-12 border-b border-border">
    <div class="mx-auto max-w-4xl px-6">
      <div class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-2">
          <Badge variant="brand" pill>
            <Icon name={location.is_secret ? 'lock' : 'map-pin'} size="sm" />
            {location.is_secret ? 'Secret Location' : 'Pin Location'}
          </Badge>
          {difficulty && (
            <span class={`rounded-full px-3 py-1 text-xs font-semibold ${difficultyColor(location.difficulty_level)}`}>
              {difficulty}
            </span>
          )}
        </div>

        <h1 class="font-display text-3xl sm:text-4xl font-bold text-foreground leading-tight">
          {location.name}
        </h1>

        {location.description && (
          <p class="text-foreground-muted text-lg leading-relaxed max-w-2xl">
            {location.description}
          </p>
        )}

        <div class="flex flex-wrap gap-3 mt-2">
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium text-foreground hover:border-brand-500 hover:text-brand-500 transition-colors"
          >
            <Icon name="map" size="sm" />
            Open in Maps
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Map + details -->
  <section class="py-10 bg-background-secondary border-b border-border">
    <div class="mx-auto max-w-4xl px-6 grid gap-6 md:grid-cols-5">

      <!-- Interactive mini-map -->
      <div class="md:col-span-3">
        <div class="rounded-2xl overflow-hidden border border-border shadow-sm" style="height: 280px;">
          <MiniMap lat={location.latitude} lng={location.longitude} name={location.name} client:load />
        </div>
        <p class="mt-2 text-xs text-foreground-subtle text-center">
          © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer" class="hover:underline">OpenStreetMap</a> contributors © <a href="https://carto.com/" target="_blank" rel="noopener noreferrer" class="hover:underline">CARTO</a>
        </p>
      </div>

      <!-- Details sidebar -->
      <div class="md:col-span-2 flex flex-col gap-3">
        <Card padding="sm">
          <h2 class="text-xs font-semibold text-foreground-muted uppercase tracking-wide mb-3">Location Details</h2>
          <dl class="space-y-2.5">
            <div class="flex items-center gap-2 text-sm">
              <Icon name="map-pin" size="sm" class="text-foreground-subtle shrink-0" />
              <dt class="text-foreground-muted shrink-0">Coordinates</dt>
              <dd class="ml-auto font-mono text-xs text-foreground-muted">
                {location.latitude.toFixed(4)}, {location.longitude.toFixed(4)}
              </dd>
            </div>
            {location.difficulty_level && (
              <div class="flex items-center gap-2 text-sm">
                <Icon name="zap" size="sm" class="text-foreground-subtle shrink-0" />
                <dt class="text-foreground-muted shrink-0">Difficulty</dt>
                <dd class={`ml-auto text-xs font-semibold rounded-full px-2 py-0.5 ${difficultyColor(location.difficulty_level)}`}>
                  {difficulty}
                </dd>
              </div>
            )}
          </dl>
          <div class="mt-2.5 pt-2.5 border-t border-[var(--border)]">
            <LocationStats locationId={location.id} client:load />
          </div>
        </Card>

        {location.reward_description && (
          <Card padding="sm" class="border-brand-500/20 bg-brand-500/5">
            <div class="flex items-start gap-2">
              <Icon name="star" size="sm" class="text-brand-500 shrink-0 mt-0.5" />
              <div>
                <p class="text-xs font-semibold text-brand-500 mb-1">Reward</p>
                <p class="text-sm text-foreground-muted">{location.reward_description}</p>
              </div>
            </div>
          </Card>
        )}

        <CheckInButton locationId={location.id} locationName={location.name} characterSlugs={location.character_slugs ?? []} client:load />

        {collections.length > 0 && (
          <Card padding="sm">
            <h2 class="text-xs font-semibold text-foreground-muted uppercase tracking-wide mb-3">Part of</h2>
            <div class="flex flex-col gap-2">
              {collections.map((col: any) => (
                <CollectionProgressTag
                  collectionSlug={col.slug}
                  collectionName={col.name}
                  client:load
                />
              ))}
            </div>
          </Card>
        )}
      </div>
    </div>
  </section>

  <!-- Character sightings -->
  {characters.length > 0 && (
    <section class="py-10 bg-background border-b border-border">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class="text-sm font-semibold text-foreground-muted uppercase tracking-wide mb-4">
          Who you might meet here
        </h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {characters.map((char: any) => (
            <a
              href={`/characters/${char.slug}`}
              class="flex items-start gap-3 rounded-xl border border-border bg-background-secondary p-4 hover:border-brand-500 transition-colors group"
            >
              {char.avatar ? (
                <img
                  src={(char.avatar as any).src}
                  alt={char.name}
                  width={40}
                  height={40}
                  class="rounded-full object-cover shrink-0"
                />
              ) : (
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                  <Icon name="user" size="sm" />
                </div>
              )}
              <div class="min-w-0">
                <p class="font-semibold text-foreground group-hover:text-brand-500 transition-colors text-sm">
                  {char.name}
                </p>
                <p class="text-xs text-foreground-muted mt-0.5 line-clamp-2">{char.bio}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Discussion -->
  <section class="py-10 bg-background">
    <div class="mx-auto max-w-4xl px-6">
      <LocationDiscussion locationId={location.id} client:load />
    </div>
  </section>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
</PageLayout>

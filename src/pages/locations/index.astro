---
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import LocationsMap from '@/components/locations/LocationsMap';
---
<PageLayout title="Visit QCMM Locations and check-in for perks" description="Every festival spot, mapped across downtown Staunton." bgImage="/staunton.jpg">
  <Hero layout="centered" size="sm" class="isolate" bgImage="/staunton.jpg">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="map-pin" size="sm" />
      Locations
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Find your</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">next pin.</span>
    </h1>
    <p slot="description">Every festival spot, mapped across downtown Staunton.</p>
    <!-- SUPPRESSED for festival: Sign in to check in button -->
  </Hero>

  <section class="relative z-10 py-16 bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <LocationsMap client:load />
    </div>
  </section>

  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
</PageLayout>

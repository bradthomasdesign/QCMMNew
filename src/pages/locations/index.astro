---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import LocationsMap from '@/components/locations/LocationsMap';

const allLocations = await getCollection('locations', (l) => l.data.is_active);
const locations = allLocations
  .map((l) => ({
    slug: l.id,
    name: l.data.name,
    description: l.data.description ?? null,
    latitude: l.data.latitude,
    longitude: l.data.longitude,
    is_secret: l.data.is_secret,
    difficulty_level: l.data.difficulty_level ?? null,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---
<PageLayout title="Visit QCMM Locations and check-in for perks" description="Every festival spot, mapped across downtown Staunton." bgImage="/staunton.jpg">
  <Hero layout="centered" size="sm" class="isolate" bgImage="/staunton.jpg">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="map-pin" size="sm" />
      Locations
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Find QCMM</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">Locations</span>
    </h1>
    <p slot="description">Every festival spot, mapped across downtown Staunton.</p>
    <div slot="actions">
      <a
        href="/2026-festival-map.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
        Download Festival Map
      </a>
    </div>
  </Hero>

  <section class="relative z-10 py-16 bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <LocationsMap locations={locations} client:load />
    </div>
  </section>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
</PageLayout>
